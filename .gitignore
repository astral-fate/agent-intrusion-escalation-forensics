# Cached third-party source bytes are deliberately NOT redistributed -- the paper and README
# both say so. Only the manifest travels, and `python ingest/run_all.py --refresh` re-fetches
# the sources and reports any digest that no longer matches.
cache/*
!cache/manifest.json

# LaTeX build products. main.tex is generated by verify.py and main.pdf is the deliverable,
# so both are tracked; the intermediates are not.
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.tex.tmpl.bak*
paper/references.bib.bak*

__pycache__/
*.py[cod]
.pytest_cache/
.omc/
.venv/
venv/
.DS_Store

# development notes kept locally, not part of the release
docs/DEVNOTES-old-readme.md
